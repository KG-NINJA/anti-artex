{
  "name": "anti-artex",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "npm run build && node --test dist/test/*.test.js test/*.test.mjs",
    "bundle": "wrangler deploy --dry-run --outdir dist/worker",
    "smoke:local": "node test/local-smoke.mjs",
    "test:interop": "node scripts/verify-interop.mjs",
    "verify:evidence": "npm run build --silent && node scripts/verify-evidence.mjs",
    "lab:validate": "npm run build && node scripts/validation-lab.mjs",
    "benchmark:triage": "npm run build && node scripts/prompt-triage-benchmark.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "wrangler": "^4.151.3"
  }
}
